# Byte-compiled / optimized / DLL files
__pycache__/
__pycache__/*
*.py[cod]
*$py.class
*.so
.DS_Store

# Testing & IDEs
.pytest_cache/
.coverage
htmlcov/
.idea/
.vscode/

# Ignore notebooks globally
*.ipynb

# Un-ignore specific folders so Git can read their contents
!examples/
!examples/**/
!examples/*.ipynb
!examples/**/*.ipynb

# same as above
#!notebooks/
#!notebooks/*.ipynb
#!notebooks/**/*.ipynb
#!tests/**/*.ipynb  # allows .ipynb in tests/ folder
#!tests/*.ipynb     # allows .ipynb inside any subdirectories of tests/

# Logs
*.log

# Virtual environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/


# Project archives and legacy code
archive/
old/
scratch/
logos/

# Development files:
# files prefixed with `NN-` or suffixed with `_vN` 
# are considered experimental and are ignored by git.

# Files starting with digits (00-, 01-, 02-, ...)
lmfit_global/[0-9]*-*.py
lmfit_global/utils/[0-9]*-*.py

# Versioned files (_v1, _v2, ...)
lmfit_global/*_v*.py
lmfit_global/utils/*_v*.py

